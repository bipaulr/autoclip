# Copy to .env, or run: py -3.12 setup_wizard.py  (it fills the service keys for you)

# --- LLM (names come from env, never hard-coded) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_MODEL=llama3.2:3b

# --- YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=

# --- Instagram ---
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_USERNAME=
IG_GRAPH_HOST=graph.facebook.com
IG_TOKEN_TYPE=user_long_lived
IG_REFRESH_THRESHOLD_DAYS=15

# --- Twitch ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Transcription and clip selection ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=30
IG_MAX_SECONDS=30
PRIORITY_KEYWORDS=gta 6,gta vi,gta6,gtavi,grand theft auto 6,grand theft auto vi
PRIORITY_BOOST=3
OWNER_AWAY_IST=02:00-10:00
HIGHLIGHTS_PER_VIDEO=5

# DATABASE_URL, REDIS_URL, OLLAMA_HOST and MEDIA_DIR are set by docker-compose.yml
DOWNLOAD_FRAGMENTS=8
NO_POST_IST=01:00-17:00
MORNING_WINDOW_IST=10:00-13:00
MORNING_CAMPAIGNS=
AUTO_SUBMIT_CAMPAIGNS=
AUTO_WINDOW_IST=05:30-09:30
AUTO_SUBMIT_DRY_RUN=false
AUTO_SUBMIT_ALWAYS=true
