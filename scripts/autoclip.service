# Linux (systemd) equivalent of start-on-boot.ps1. Install with:
#   sudo cp scripts/autoclip.service /etc/systemd/system/ && sudo systemctl enable --now autoclip
# Edit WorkingDirectory to where autoclip lives.
[Unit]
Description=autoclip
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/autoclip
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
